#!/usr/bin/env bash

set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
vscode_files_manifest="$repo_root/manifest/vscode-files.txt"
nvim_files_manifest="$repo_root/manifest/nvim-files.txt"
extensions_manifest="$repo_root/manifest/vscode-extensions.txt"
version_file="$repo_root/VERSION"

target_home=${HOME:?HOME is not set}
dry_run=false
skip_extensions=false
skip_system_settings=false
component=all
backup_root=
backup_used=false

usage() {
    cat <<'EOF'
Usage:
  ./zdotfiles setup [options]
  ./zdotfiles verify [options]
  ./zdotfiles version
  ./zdotfiles help

Options:
  --home PATH             Use PATH as the target home directory
  --only nvim|vscode       Manage only the selected editor (default: both)
  --dry-run               Print setup actions without changing anything
  --skip-extensions       Skip all VS Code extension installation/checks
  --skip-system-settings  Skip GNOME/IBus settings
  -h, --help              Show this help
EOF
}

die() {
    printf 'zdotfiles: %s\n' "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

parse_options() {
    while (($#)); do
        case "$1" in
            --home)
                (($# >= 2)) || die '--home requires a path'
                target_home=$2
                shift 2
                ;;
            --only)
                (($# >= 2)) || die '--only requires nvim or vscode'
                [[ $component = all ]] || die '--only may be specified only once'
                case "$2" in
                    nvim|vscode) component=$2 ;;
                    *) die "unknown component: $2 (expected nvim or vscode)" ;;
                esac
                shift 2
                ;;
            --dry-run)
                dry_run=true
                shift
                ;;
            --skip-extensions)
                skip_extensions=true
                shift
                ;;
            --skip-system-settings)
                skip_system_settings=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                die "unknown option: $1"
                ;;
        esac
    done

    [[ $target_home = /* ]] || die '--home must be an absolute path'
    [[ $target_home != / ]] || die 'refusing to use / as the target home'
    target_home=${target_home%/}
}

for_each_manifest_entry() {
    local manifest=$1
    local callback=$2
    local entry

    [[ -f $manifest ]] || die "missing manifest: $manifest"
    while IFS= read -r entry || [[ -n $entry ]]; do
        [[ -z $entry || $entry = \#* ]] && continue
        [[ $entry != /* && $entry != *'..'* ]] || die "unsafe manifest entry: $entry"
        "$callback" "$entry"
    done < "$manifest"
}

prepare_backup_root() {
    local state_root

    if [[ $target_home = ${HOME:-} && -n ${XDG_STATE_HOME:-} ]]; then
        state_root=$XDG_STATE_HOME
    else
        state_root="$target_home/.local/state"
    fi
    backup_root="$state_root/zdotfiles/backups/$(date +%Y%m%d-%H%M%S)"
}

install_file() {
    local relative_path=$1
    local source_path="$repo_root/$relative_path"
    local destination_path="$target_home/$relative_path"
    local destination_directory
    local staged_path
    local backup_path

    [[ -f $source_path ]] || die "source file is missing: $relative_path"

    if [[ -f $destination_path ]] && cmp -s -- "$source_path" "$destination_path"; then
        note "unchanged  $relative_path"
        return
    fi

    if $dry_run; then
        if [[ -e $destination_path || -L $destination_path ]]; then
            note "would back up and install  $relative_path"
        else
            note "would install              $relative_path"
        fi
        return
    fi

    destination_directory=${destination_path%/*}
    mkdir -p -- "$destination_directory"
    staged_path="$destination_path.zdotfiles-stage.$$"
    cp -a -- "$source_path" "$staged_path"

    if [[ -e $destination_path || -L $destination_path ]]; then
        backup_path="$backup_root/$relative_path"
        mkdir -p -- "${backup_path%/*}"
        mv -- "$destination_path" "$backup_path"
        backup_used=true
    fi

    mv -- "$staged_path" "$destination_path"
    note "installed  $relative_path"
}

verify_file() {
    local relative_path=$1
    local source_path="$repo_root/$relative_path"
    local destination_path="$target_home/$relative_path"

    if [[ ! -e $destination_path && ! -L $destination_path ]]; then
        note "missing    $relative_path"
        verify_failed=true
    elif ! cmp -s -- "$source_path" "$destination_path"; then
        note "different  $relative_path"
        verify_failed=true
    else
        note "ok         $relative_path"
    fi
}

installed_extensions_cache=

load_installed_extensions() {
    if [[ -z $installed_extensions_cache ]]; then
        installed_extensions_cache=$(code --list-extensions 2>/dev/null || true)
    fi
}

install_extension() {
    local extension_id=$1

    load_installed_extensions
    if grep -Fqx -- "$extension_id" <<<"$installed_extensions_cache"; then
        note "unchanged  VS Code extension $extension_id"
        return
    fi

    if $dry_run; then
        note "would install VS Code extension $extension_id"
        return
    fi

    code --install-extension "$extension_id"
    installed_extensions_cache+=$'\n'"$extension_id"
}

verify_extension() {
    local extension_id=$1

    load_installed_extensions
    if grep -Fqx -- "$extension_id" <<<"$installed_extensions_cache"; then
        note "ok         VS Code extension $extension_id"
    else
        note "missing    VS Code extension $extension_id"
        verify_failed=true
    fi
}

can_manage_ibus() {
    command -v gsettings >/dev/null 2>&1 \
        && gsettings list-schemas | grep -Fqx 'org.freedesktop.ibus.panel.emoji' \
        && gsettings list-keys org.freedesktop.ibus.panel.emoji | grep -Fqx 'hotkey'
}

setup_system_settings() {
    local expected="['<Super>semicolon']"
    local current

    if ! can_manage_ibus; then
        note 'skipped    IBus emoji hotkey (schema unavailable)'
        return
    fi

    current=$(gsettings get org.freedesktop.ibus.panel.emoji hotkey)
    if [[ $current = "$expected" ]]; then
        note 'unchanged  IBus emoji hotkey'
    elif $dry_run; then
        note "would set IBus emoji hotkey to $expected"
    else
        gsettings set org.freedesktop.ibus.panel.emoji hotkey "$expected"
        note 'installed  IBus emoji hotkey'
    fi
}

verify_system_settings() {
    local expected="['<Super>semicolon']"
    local current

    if ! can_manage_ibus; then
        note 'skipped    IBus emoji hotkey (schema unavailable)'
        return
    fi

    current=$(gsettings get org.freedesktop.ibus.panel.emoji hotkey)
    if [[ $current = "$expected" ]]; then
        note 'ok         IBus emoji hotkey'
    else
        note "different  IBus emoji hotkey: $current"
        verify_failed=true
    fi
}

nvim_preflight() {
    local missing=false executable version
    if [[ ${NVIM_APPNAME:-nvim} != nvim ]]; then
        note 'unsupported NVIM_APPNAME: this installer deploys the nvim configuration'
        return 1
    fi
    if [[ ${XDG_CONFIG_HOME:-$HOME/.config} != "$HOME/.config" ]]; then
        note 'unsupported XDG_CONFIG_HOME: this installer deploys to ~/.config'
        return 1
    fi
    for executable in nvim git cc curl tar rg rust-analyzer basedpyright-langserver; do
        if ! command -v "$executable" >/dev/null 2>&1; then
            note "missing    Neovim dependency: $executable"
            missing=true
        fi
    done
    if command -v rust-analyzer >/dev/null 2>&1 && ! rust-analyzer --version >/dev/null 2>&1; then
        note 'missing    rust-analyzer toolchain component (run rustup component add rust-analyzer)'
        missing=true
    fi
    if command -v nvim >/dev/null 2>&1; then
        version=$(NVIM_LOG_FILE=/dev/null nvim --version)
        if [[ ! $version =~ NVIM\ v([0-9]+)\.([0-9]+)\.([0-9]+) ]] ||
            (( BASH_REMATCH[1] == 0 && (BASH_REMATCH[2] < 11 || (BASH_REMATCH[2] == 11 && BASH_REMATCH[3] < 2)) )); then
            note 'missing    Neovim >= 0.11.2'
            missing=true
        fi
    fi
    if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
        if ! command -v wl-copy >/dev/null 2>&1 || ! command -v wl-paste >/dev/null 2>&1; then
            note 'missing    Wayland clipboard: install wl-clipboard'
            missing=true
        fi
    elif [[ -n ${DISPLAY:-} ]]; then
        if ! command -v xclip >/dev/null 2>&1 && ! command -v xsel >/dev/null 2>&1; then
            note 'missing    X11 clipboard: install xclip'
            missing=true
        fi
    else
        note 'skipped    desktop clipboard check (no graphical session)'
    fi
    ! $missing
}

nvim_runtime() {
    nvim --headless -u NONE -i NONE -l "$repo_root/scripts/nvim.lua" "$1"
}

setup() {
    if [[ $component != vscode && $target_home = ${HOME:-} ]]; then
        nvim_preflight || die 'Neovim prerequisites are missing (see docs/configuration.md)'
    fi
    prepare_backup_root
    note "zdotfiles $(<"$version_file") setup -> $target_home"
    if [[ $component != nvim ]]; then
        for_each_manifest_entry "$vscode_files_manifest" install_file

        if ! $skip_extensions; then
            if [[ $target_home != ${HOME:-} ]]; then
                note 'skipped    VS Code extensions (--home is not current HOME)'
            elif command -v code >/dev/null 2>&1; then
                command -v python3 >/dev/null 2>&1 || die 'python3 is required to install the local VS Code extension'
                if $dry_run; then
                    python3 "$repo_root/scripts/local-extension.py" setup --dry-run
                else
                    python3 "$repo_root/scripts/local-extension.py" setup
                fi
                for_each_manifest_entry "$extensions_manifest" install_extension
            else
                note 'skipped    VS Code extensions (code command unavailable)'
            fi
        fi

        if ! $skip_system_settings; then
            if [[ $target_home != ${HOME:-} ]]; then
                note 'skipped    system settings (--home is not current HOME)'
            else
                setup_system_settings
            fi
        fi
    fi

    if [[ $component != vscode ]]; then
        for_each_manifest_entry "$nvim_files_manifest" install_file
        if [[ $target_home != ${HOME:-} ]]; then
            note 'skipped    Neovim runtime (--home is not current HOME)'
        elif $dry_run; then
            note 'would restore Neovim plugins from lazy-lock.json, install parsers, and verify startup'
        else
            nvim_runtime setup
            nvim_runtime parsers
            nvim_runtime verify
        fi
    fi

    if $backup_used; then
        note "backup    $backup_root"
    fi
}

verify() {
    verify_failed=false
    note "zdotfiles $(<"$version_file") verify -> $target_home"
    if [[ $component != nvim ]]; then
        for_each_manifest_entry "$vscode_files_manifest" verify_file

        if ! $skip_extensions && [[ $target_home = ${HOME:-} ]]; then
            if command -v code >/dev/null 2>&1; then
                command -v python3 >/dev/null 2>&1 || die 'python3 is required to verify the local VS Code extension'
                if ! python3 "$repo_root/scripts/local-extension.py" verify; then
                    verify_failed=true
                fi
                for_each_manifest_entry "$extensions_manifest" verify_extension
            else
                note 'skipped    VS Code extensions (code command unavailable)'
            fi
        fi

        if ! $skip_system_settings && [[ $target_home = ${HOME:-} ]]; then
            verify_system_settings
        fi
    fi

    if [[ $component != vscode ]]; then
        for_each_manifest_entry "$nvim_files_manifest" verify_file
        if [[ $target_home != ${HOME:-} ]]; then
            note 'skipped    Neovim runtime (--home is not current HOME)'
        elif ! nvim_preflight; then
            verify_failed=true
        elif ! nvim_runtime verify; then
            verify_failed=true
        fi
    fi

    if $verify_failed; then
        return 1
    fi
}

command_name=${1:-help}
if (($#)); then
    shift
fi

case "$command_name" in
    setup)
        parse_options "$@"
        setup
        ;;
    verify)
        parse_options "$@"
        verify
        ;;
    version|--version|-V)
        (($# == 0)) || die 'version does not accept options'
        cat "$version_file"
        ;;
    help|--help|-h)
        (($# == 0)) || die 'help does not accept options'
        usage
        ;;
    *)
        die "unknown command: $command_name (try ./zdotfiles help)"
        ;;
esac
