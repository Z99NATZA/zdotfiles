[
    {
        "key": "alt+k",
        "command": "editor.action.moveLinesUpAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "alt+j",
        "command": "editor.action.moveLinesDownAction",
        "when": "editorTextFocus && !editorReadonly"
    },
    {
        "key": "ctrl+0",
        "command": "workbench.action.focusSideBar",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+0",
        "command": "workbench.action.focusActiveEditorGroup",
        "when": "sideBarFocus"
    },
    {
        "key": "ctrl+b",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "meta+[Minus]",
        "command": "znnn.focusedPane.shrink"
    },
    {
        "key": "meta+[Equal]",
        "command": "znnn.focusedPane.expand"
    },
    {
        "key": "meta+[Minus]",
        "command": "workbench.action.increaseViewHeight",
        "when": "terminalFocus && !terminalEditorFocus"
    },
    {
        "key": "meta+[Equal]",
        "command": "workbench.action.decreaseViewHeight",
        "when": "terminalFocus && !terminalEditorFocus"
    },
    {
        "key": "meta+[Comma]",
        "command": "znnn.sidebar.shrink",
        "args": {
            "restoreCommand": "workbench.action.focusActiveEditorGroup"
        },
        "when": "sideBarVisible && !sideBarFocus"
    },
    {
        "key": "meta+[Period]",
        "command": "znnn.sidebar.expand",
        "args": {
            "restoreCommand": "workbench.action.focusActiveEditorGroup"
        },
        "when": "sideBarVisible && !sideBarFocus"
    },
    {
        "key": "meta+[Comma]",
        "command": "znnn.sidebar.shrink",
        "when": "sideBarVisible && sideBarFocus"
    },
    {
        "key": "meta+[Period]",
        "command": "znnn.sidebar.expand",
        "when": "sideBarVisible && sideBarFocus"
    },
    {
        "key": "meta+[Comma]",
        "command": "znnn.sidebar.shrink",
        "args": {
            "restoreCommand": "workbench.action.terminal.focus"
        },
        "when": "sideBarVisible && terminalFocus && !terminalEditorFocus"
    },
    {
        "key": "meta+[Period]",
        "command": "znnn.sidebar.expand",
        "args": {
            "restoreCommand": "workbench.action.terminal.focus"
        },
        "when": "sideBarVisible && terminalFocus && !terminalEditorFocus"
    },
    {
        "key": "meta+[Comma]",
        "command": "znnn.sidebar.shrink",
        "args": {
            "restoreCommand": "workbench.action.focusPanel"
        },
        "when": "sideBarVisible && panelFocus && !terminalFocus"
    },
    {
        "key": "meta+[Period]",
        "command": "znnn.sidebar.expand",
        "args": {
            "restoreCommand": "workbench.action.focusPanel"
        },
        "when": "sideBarVisible && panelFocus && !terminalFocus"
    },
    {
        "key": "meta+[Comma]",
        "command": "znnn.sidebar.shrink",
        "args": {
            "restoreCommand": "workbench.action.focusAuxiliaryBar"
        },
        "when": "sideBarVisible && auxiliaryBarFocus"
    },
    {
        "key": "meta+[Period]",
        "command": "znnn.sidebar.expand",
        "args": {
            "restoreCommand": "workbench.action.focusAuxiliaryBar"
        },
        "when": "sideBarVisible && auxiliaryBarFocus"
    },
    {
        "key": "meta+[KeyH]",
        "command": "workbench.action.previousEditorInGroup"
    },
    {
        "key": "meta+[KeyL]",
        "command": "workbench.action.nextEditorInGroup"
    },
    {
        "key": "meta+w",
        "command": "workbench.action.closeActiveEditor",
        "when": "editorTextFocus"
    },
    {
        "key": "ctrl+d",
        "command": "editor.action.addSelectionToNextFindMatch",
        "when": "editorTextFocus && vim.active && vim.mode == 'Visual'"
    },
    {
        "key": "ctrl+c",
        "command": "-editor.action.clipboardCopyAction",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+insert",
        "command": "-editor.action.clipboardCopyAction",
        "when": "textInputFocus"
    }
]
